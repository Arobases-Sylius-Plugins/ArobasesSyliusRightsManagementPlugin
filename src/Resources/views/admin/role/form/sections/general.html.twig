{% set form = hookable_metadata.context.form %}

<div class="col-12">
    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-6">
                    {{ form_row(form.code) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_row(form.name) }}
                </div>
            </div>
        </div>
    </div>
</div>
