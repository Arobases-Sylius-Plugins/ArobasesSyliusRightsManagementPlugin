{% set form = hookable_metadata.context.form %}

{{ form_errors(form.rights) }}
{% for group, rights in arobases_rights_plugin_get_formatted_right_array(form.rights) %}
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card mb-3">
            <div class="card-header">
                <div class="card-title">{{ group|trans }}</div>
            </div>
            <div class="card-body">
                {% for right in rights %}
                    {{ form_row(right) }}
                {% endfor %}
            </div>
        </div>
    </div>
{% endfor %}
{% do form.rights.setRendered %}
